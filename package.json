{
  "name": "orari-i-punes",
  "version": "1.0.0",
  "description": "Orari i Punës",
  "author": "Orari",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "win": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/core": "6.2.0",
    "@capacitor/filesystem": "6.0.2",
    "@capacitor/share": "6.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "6.2.0",
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.orari.punes",
    "productName": "Orari i Punës",
    "files": ["electron/**", "www/**", "build/icon.png"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "build/icon.png", "artifactName": "Orari-i-Punes-Setup.exe" },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Orari i Punës" }
  }
}
